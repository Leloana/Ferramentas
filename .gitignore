# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/

# Environment Variables & Secrets
.env
oauth.json
token.json
credentials.json
client_secrets.json
client_secret_*.json
client-tv.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Build
build/
dist/
*.egg-info/

# Karaoke Song Files (Ignore all generated audio/lyrics, keep only meta.json)
karaoke/server/songs/**/*
!karaoke/server/songs/**/meta.json
!karaoke/server/songs/**/

# Pipeline project runs and scratch
pipeline-project/runs/
pipeline-project/scratch/
pipeline-project/.srclight/
.srclight/

# Player Profiles
karaoke/players/

# TTS Platform: áudio gerado e vozes clonadas enviadas pelo usuário
tts_platform_pt/server/output/*
!tts_platform_pt/server/output/.gitkeep
tts_platform_pt/server/voices/custom/*
!tts_platform_pt/server/voices/custom/.gitkeep
tts_platform_pt/exemplos/
# TTS Platform: áudio gerado em Projetos/ (roteiros e manifestos ficam versionados)
tts_platform_pt/Projetos/**/*.wav

# Notes
karaoke/anotar.txt

# Agentic CLI persist and history
.persist/
.history
