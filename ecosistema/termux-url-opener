#!/data/data/com.termux/files/usr/bin/bash
# termux-url-opener  --  Recebe uma URL compartilhada de qualquer app Android
# e a encaminha por SSH para o PC (Windows), que a abre no navegador padrao.
#
# Instalacao no Termux:
#   mkdir -p ~/bin && cp termux-url-opener ~/bin/ && chmod +x ~/bin/termux-url-opener
# (precisa do app Termux:API instalado + 'pkg install termux-api' para notificacoes)

URL="$1"

# Caminho do receiver.py no PC (Windows). Ajuste se mover a pasta.
PC_RECEIVER='C:\Users\mf827\Documents\Ferramentas\ecosistema\receiver.py'

notify() {
    # Notificacao opcional: so dispara se o Termux:API estiver instalado.
    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification --title "Handoff" --content "$1" --alert-once
    fi
    echo "$1"
}

if [ -z "$URL" ]; then
    notify "Nenhuma URL recebida"
    exit 1
fi

# Passa a URL ao receiver em modo --send: ele encaminha ao daemon que roda
# na sessao interativa do PC (assim a aba abre na tela visivel, nao em sessao
# 0 do servico sshd). Aspas evitam expansao de caracteres da URL.
if ssh pc-remoto "python \"$PC_RECEIVER\" --send \"$URL\""; then
    notify "Link enviado para o PC"
else
    notify "Erro ao enviar link (PC ligado? sshd ativo?)"
    exit 1
fi
