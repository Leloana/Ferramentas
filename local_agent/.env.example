# Copie para .env e ajuste conforme necessário.

LOCAL_AGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Use "local-agent" depois de rodar setup.ps1 (Modelfile com num_ctx/temperature
# já ajustados). Sem isso, usa o modelo cru "qwen3.5:9b-instruct".
LOCAL_AGENT_MODEL=local-agent

LOCAL_AGENT_MAX_ITERS=6
LOCAL_AGENT_TOOL_TIMEOUT=15
LOCAL_AGENT_TASK_TIMEOUT=90
LOCAL_AGENT_TEMPERATURE=0.3
LOCAL_AGENT_TOP_P=0.9

# Lista de diretórios permitidos para as ferramentas de arquivo, separados por ";"
# (use ":" em Linux/Mac). Default: pasta do usuário.
# LOCAL_AGENT_ALLOWED_DIRS=C:\Users\mf827\Documents;C:\Users\mf827\Downloads
